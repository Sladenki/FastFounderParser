# Сессионная cookie из браузера, где ты залогинен на fastfounder.ru.
# DevTools → Application → Cookies → https://fastfounder.ru
# Одной строкой, значения не публикуй.
COOKIE=

# Папка FastFounder на Google Диске.
DRIVE_FOLDER_ID=1nAw_Zoowbmv5vIeiidHWEaE3KD-m_ZjH

# Если установлен Google Drive для компьютера и эта папка синхронизируется
# локально, укажи путь. Тогда копия пишется туда сразу, без API.
# DRIVE_LOCAL_DIR=G:\My Drive\FastFounder
